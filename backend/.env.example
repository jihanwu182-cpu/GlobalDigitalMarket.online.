# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=globalmarket
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API Configuration
API_BASE_URL=http://localhost:5000
API_PREFIX=/api

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Market Data API (Alpha Vantage example)
MARKET_DATA_API_KEY=your-api-key-here
MARKET_DATA_API_URL=https://www.alphavantage.co/query

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@globalmarket.com

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
SESSION_SECRET=your-session-secret-key
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Trading Configuration
MIN_TRADE_AMOUNT=1
MAX_TRADE_AMOUNT=1000000
DEFAULT_COMMISSION=0.001

# Feature Flags
ENABLE_OPTIONS_TRADING=false
ENABLE_CRYPTO_TRADING=false
ENABLE_MARGIN_TRADING=true
